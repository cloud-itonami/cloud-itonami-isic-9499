;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a document-courier robot handles physical
;; member-mailing fulfillment for a membership organization (ISIC 9499),
;; gated by the Membership Governance Governor. Its physical work is the
;; member-magazine mailing: stacking wrapped magazine bundles onto a pallet
;; and moving the loaded pallet to the dispatch bay.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-9499"
 :cases
 [{:id :magazine-bundle-onto-pallet
   :kind :manipulator
   :procedure "arm swings a 10 kg bundle of wrapped member magazines from the infeed conveyor onto the pallet stack; the sweep is how fast the move is made"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.5 :payload-kg 10.0
            :from [0.70 0.30] :to [0.20 0.80] :steps 500}
   :sweep {:param :duration-s :values [0.6 0.8 1.0 1.5 2.0 3.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: peak shoulder torque of a 15 kg-payload-class palletising arm"}
   :boundary {:lo 0.3 :hi 5.0}}
  {:id :pallet-to-dispatch-bay
   :kind :transport
   :procedure "autonomous pallet mover carries the loaded pallet of magazine bundles from the mailing room to the dispatch bay"
   :params {:mass-kg 150.0 :distance-m 50.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 300.0 :crr 0.015
            :cog-height-m 0.25 :support-half-length-m 0.50 :payload-cog-height-m 0.80
            :max-time-s 1800.0}
   :sweep {:param :payload-kg :values [200.0 400.0 600.0 800.0 1000.0 1200.0]}
   :quantity :cycle-time-s
   :limit {:max 70.0 :basis "estimate: one mailing-room-to-dispatch leg inside the carrier's collection slot"}
   :boundary {:lo 50.0 :hi 3000.0}}]}
